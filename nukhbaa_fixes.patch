+  'Manchester United': TeamBrand(ar: 'مانشستر يونايتد', c1: _hex('#DA291C'), c2: _hex('#FBE122'), espnId: 360),
+  'Nottingham Forest': TeamBrand(ar: 'نوتينغهام فورست', c1: _hex('#E53233'), c2: _hex('#FFFFFF'), espnId: 393),
