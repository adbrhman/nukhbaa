# Nukhba backend configuration. Copy to .env and fill in.
# SECURITY: the service-role key bypasses RLS. Never commit .env. (Security ADR s7)

# Postgres (Supabase managed). Use the service-role/privileged connection ON THE SERVER ONLY.
NUKHBA_PG_HOST=localhost
NUKHBA_PG_PORT=5432
NUKHBA_PG_DATABASE=postgres
NUKHBA_PG_USERNAME=postgres
NUKHBA_PG_PASSWORD=
NUKHBA_PG_SSL=require
# Optional: connection pool size (default 8, held within 2..40). Read at
# boot, so it changes on the host without a release.
NUKHBA_PG_POOL_SIZE=8

# Supabase Auth (JWT verification). The backend verifies Supabase-issued JWTs
# locally (Security ADR s2): primary ES256 via the project JWKS endpoint, with
# an HS256 shared-secret fallback for legacy projects.
#
# Required: the project ref (the `<ref>` in https://<ref>.supabase.co). The
# expected issuer and JWKS URI are derived from it so they cannot drift.
NUKHBA_SUPABASE_PROJECT_REF=
# Optional: expected audience claim (defaults to `authenticated`).
NUKHBA_SUPABASE_JWT_AUD=authenticated
# Optional: legacy shared HS256 secret. Set ONLY for legacy (pre-2025-10)
# projects still signing with the project JWT secret. Absent on modern
# ES256-only projects. SECURITY: never commit a real value.
NUKHBA_SUPABASE_JWT_SECRET=
# Required by every /auth/* route (register, login, refresh, Google,
# password reset): the project's publishable key (sb_publishable_...) or
# the legacy anon JWT. Public by design, not a secret. When unset those
# routes answer "Email/password auth is not configured on this server".
NUKHBA_SUPABASE_ANON_KEY=

# Server
NUKHBA_ENV=development
# NOTE: the port is read by dart_frog from the standard PORT variable
# (Cloud Run sets it automatically). NUKHBA_PORT is NOT read by anything.
PORT=8080

# CORS allow-list (comma-separated, scheme://host only — NO path, because the
# browser's Origin header never includes one). Read by
# apps/server/routes/_middleware.dart; when unset it falls back to the
# built-in list of every host the web build is served from (+ localhost
# outside production). When set, it REPLACES that list, so it must name all
# of them.
NUKHBA_CORS_ALLOWED_ORIGINS=https://nukhbaa.app,https://www.nukhbaa.app,https://p01--nukhbaa-web--42bcqlpqwp8m.code.run,https://adbrhman.github.io

# Password reset landing page. Add the same URL to Supabase Auth Redirect URLs.
NUKHBA_PASSWORD_RESET_REDIRECT_URL=https://adbrhman.github.io/nukhbaa/reset-password

# In-process schedulers (reminders, scoring sweeps, monthly seasons, weekly
# league, badges, referrals, provider sync). ON unless exactly `off`. Set
# `off` for a local server on a shared database, so it does not race the
# deployed one.
NUKHBA_SCHEDULERS=on

# Push notifications (FCM HTTP v1): the whole service-account key file as
# one JSON value (needs project_id, client_email, private_key). Unset or
# unparsable: pushes are skipped and the server still boots.
# SECURITY: holds a private key. Never commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Automatic fixtures and results: off | shadow | on (anything else is off;
# shadow fetches and logs, writes nothing). Stays off unless at least one
# provider key below is set; a league whose provider has no key is skipped.
# SECURITY: the provider keys are secrets.
NUKHBA_PROVIDER_SYNC=off
NUKHBA_FOOTBALL_DATA_API_KEY=
NUKHBA_HIGHLIGHTLY_API_KEY=

# Optional: any GitHub token (the repository is public). Lifts GitHub's 60
# calls an hour for GET /app/latest-build. SECURITY: never commit a real value.
NUKHBA_GITHUB_TOKEN=
